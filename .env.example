# Окружение
ENVIRONMENT=production
DOMAIN=obsuzhdalych.ru
APP_URL=https://obsuzhdalych.ru

# Порт, на котором слушает Docker (проксируется хостовым Nginx)
HTTP_PORT=3000

# Секретный ключ для JWT
SECRET_KEY=max_smart_housing_super_secret_jwt_key_2026_change_in_prod

# Токен бота MAX
MAX_BOT_TOKEN=your_max_bot_token_here

# PostgreSQL
POSTGRES_DB=smart_housing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=smart_housing_secure_db_password_2026
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:smart_housing_secure_db_password_2026@postgres:5432/smart_housing